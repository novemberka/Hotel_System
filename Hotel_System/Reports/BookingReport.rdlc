    RoomNumber NVARCHAR(10) NOT NULL UNIQUE,
    RoomTypeID INT NOT NULL,
    Status NVARCHAR(20) DEFAULT 'Available', 
    FOREIGN KEY (RoomTypeID) REFERENCES RoomTypes(RoomTypeID)
);</Value>
