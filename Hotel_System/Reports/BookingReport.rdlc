                    <TextRun>
                      <Value>using (ExcelPackage excel = new ExcelPackage())
{
    var ws = excel.Workbook.Worksheets.Add("Report");

    ws.Cells[1,1].Value = "Customer";
    ws.Cells[1,2].Value = "Room";
    ws.Cells[1,3].Value = "Amount";

    ws.Cells[2,1].Value = "John";
    ws.Cells[2,2].Value = "101";
    ws.Cells[2,3].Value = 200;

    File.WriteAllBytes("report.xlsx", excel.GetAsByteArray());
}</Value>
                      <Style>
