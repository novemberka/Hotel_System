                  <TextRuns>
                    <TextRun>
                      <Value>private void btnSearch_Click(object sender, EventArgs e)
{
    DateTime fromDate = dtpFrom.Value;
    DateTime toDate = dtpTo.Value;

    DataTable dt = GetWalkInReport(fromDate, toDate);

    reportViewer1.LocalReport.DataSources.Clear();
    reportViewer1.LocalReport.ReportPath = "Reports/WalkInReport.rdlc";

    ReportDataSource rds = new ReportDataSource("WalkInDataSet", dt);
    reportViewer1.LocalReport.DataSources.Add(rds);

    reportViewer1.RefreshReport();
}</Value>
