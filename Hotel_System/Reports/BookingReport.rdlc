                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>CREATE PROCEDURE sp_WalkInReport
    @FromDate DATETIME,
    @ToDate DATETIME
AS
BEGIN
    SELECT 
        C.FullName,
        C.Phone,
        RT.TypeName AS RoomType,
        CI.CheckInDate,
        CO.CheckOutDate,
        CO.TotalAmount,
        P.AmountPaid,
        (CO.TotalAmount - ISNULL(P.AmountPaid,0)) AS BalanceDue
    FROM CheckIns CI
    JOIN Customers C ON CI.CustomerID = C.CustomerID
    JOIN Rooms R ON CI.RoomID = R.RoomID
    JOIN RoomTypes RT ON R.RoomTypeID = RT.RoomTypeID
    LEFT JOIN CheckOuts CO ON CI.CheckInID = CO.CheckInID
    LEFT JOIN Payments P ON CO.CheckOutID = P.CheckOutID
    WHERE CI.CheckInDate BETWEEN @FromDate AND @ToDate
END</Value>
                      <Style>
                        <FontStyle>Normal</FontStyle>
                        <FontFamily>Courier New</FontFamily>
                        <FontWeight>Normal</FontWeight>
                        <TextDecoration>None</TextDecoration>
                        <Color>#000000</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
