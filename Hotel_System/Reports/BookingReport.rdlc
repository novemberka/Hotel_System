                  <TextRuns>
                    <TextRun>
                      <Value>SELECT 
    C.CustomerName,
    R.RoomNumber,
    B.CheckInDate,
    B.CheckOutDate,
    P.Amount
FROM Booking B
JOIN Customer C ON B.CustomerID = C.CustomerID
JOIN Rooms R ON B.RoomID = R.RoomID
JOIN Payment P ON B.BookingID = P.BookingID</Value>
                      <Style>
