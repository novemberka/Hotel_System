                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>1.CREATE TABLE Customers ( CustomerID INT IDENTITY(1,1) PRIMARY KEY, FullName VARCHAR(100) Gender NVARCHAR(10), Phone NVARCHAR(20) NOT NULL, Email NVARCHAR(100), Address NVARCHAR(255), IDCardNumber NVARCHAR(50), CreatedAt DATETIME DEFAULT GETDATE() ); 2.CREATE TABLE Admins ( AdminID INT IDENTITY(1,1) PRIMARY KEY, Username NVARCHAR(50) NOT NULL UNIQUE, Password NVARCHAR(255) NOT NULL, FullName NVARCHAR(100), Role NVARCHAR(50), CreatedAt DATETIME DEFAULT GETDATE() ); 3.CREATE TABLE RoomTypes ( RoomTypeID INT IDENTITY(1,1) PRIMARY KEY, TypeName NVARCHAR(50) NOT NULL, Description NVARCHAR(255), PricePerNight DECIMAL(10,2) NOT NULL ); 4.CREATE TABLE Rooms ( RoomID INT IDENTITY(1,1) PRIMARY KEY, RoomNumber NVARCHAR(10) NOT NULL UNIQUE, RoomTypeID INT NOT NULL, Status NVARCHAR(20) DEFAULT 'Available', FOREIGN KEY (RoomTypeID) REFERENCES RoomTypes(RoomTypeID) ); 5. CREATE TABLE Bookings ( BookingID INT IDENTITY(1,1) PRIMARY KEY, CustomerID INT NOT NULL, RoomID INT NOT NULL, BookingDate DATETIME DEFAULT GETDATE(), CheckInDate DATETIME NOT NULL, CheckOutDate DATETIME NOT NULL, Status NVARCHAR(20) DEFAULT 'Reserved', CreatedByAdminID INT, FOREIGN KEY (CustomerID) REFERENCES Customers(CustomerID), FOREIGN KEY (RoomID) REFERENCES Rooms(RoomID), FOREIGN KEY (CreatedByAdminID) REFERENCES Admins(AdminID) ); 6.CREATE TABLE CheckIns ( CheckInID INT IDENTITY(1,1) PRIMARY KEY, CustomerID INT NOT NULL, RoomID INT NOT NULL, CheckInDate DATETIME NOT NULL, CreatedByAdminID INT, FOREIGN KEY (CustomerID) REFERENCES Customers(CustomerID), FOREIGN KEY (RoomID) REFERENCES Rooms(RoomID), FOREIGN KEY (CreatedByAdminID) REFERENCES Admins(AdminID) ); 7.CREATE TABLE CheckOuts ( CheckOutID INT IDENTITY(1,1) PRIMARY KEY, CheckInID INT NOT NULL, CheckOutDate DATETIME NOT NULL, TotalAmount DECIMAL(10,2) NOT NULL, FOREIGN KEY (CheckInID) REFERENCES CheckIns(CheckInID) ); 8.CREATE TABLE Payments ( PaymentID INT IDENTITY(1,1) PRIMARY KEY, CheckOutID INT NOT NULL, PaymentDate DATETIME DEFAULT GETDATE(), AmountPaid DECIMAL(10,2) NOT NULL, PaymentMethod NVARCHAR(50), PaymentStatus NVARCHAR(20) DEFAULT 'Paid', FOREIGN KEY (CheckOutID) REFERENCES CheckOuts(CheckOutID) ); check my status please</Value>
                      <Style>
                        <FontStyle>Normal</FontStyle>
                        <FontFamily>Times New Roman</FontFamily>
                        <FontSize>12pt</FontSize>
                        <FontWeight>Normal</FontWeight>
