                  <TextRuns>
                    <TextRun>
                      <Value>Warning[] warnings;
string[] streamIds;
string mimeType;
string encoding;
string extension;

byte[] bytes = reportViewer1.LocalReport.Render(
    "PDF", null, out mimeType, out encoding, 
    out extension, out streamIds, out warnings);

System.IO.File.WriteAllBytes("report.pdf", bytes);</Value>
