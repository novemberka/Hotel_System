                  <TextRuns>
                    <TextRun>
                      <Value>private void LoadSummary(DataTable dt)
{
    lblCustomers.Text = dt.Rows.Count.ToString();

    decimal totalPaid = dt.AsEnumerable().Sum(r =&gt; r.Field&lt;decimal?&gt;("AmountPaid") ?? 0);
    decimal totalPrice = dt.AsEnumerable().Sum(r =&gt; r.Field&lt;decimal?&gt;("TotalAmount") ?? 0);

    lblAmountPaid.Text = totalPaid.ToString("C");
    lblTotalPrice.Text = totalPrice.ToString("C");
}</Value>
                      <Style>
