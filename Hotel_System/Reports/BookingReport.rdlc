                  <TextRuns>
                    <TextRun>
                      <Value>private void btnTestConnection_Click(object sender, EventArgs e)
{
    string connectionString = "Server=.;Database=HotelDB;Trusted_Connection=True;";

    using (SqlConnection conn = new SqlConnection(connectionString))
    {
        try
        {
            conn.Open();
            MessageBox.Show("Connected successfully!");
        }
        catch (Exception ex)
        {
            MessageBox.Show("Error: " + ex.Message);
        }
    }
}</Value>
