                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dataCustomer">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!CustomerName.Value</Value>
                                  <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <VerticalAlign>Middle</VerticalAlign>
                            <BorderStyle><Default>Solid</Default></BorderStyle>
                            <BorderColor><Default>#CCCCCC</Default></BorderColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dataPhone">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!PhoneNumber.Value</Value>
                                  <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style>
                                </TextRun>
                              </TextRuns>
                              <Style><TextAlign>Center</TextAlign></Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <VerticalAlign>Middle</VerticalAlign>
                            <BorderStyle><Default>Solid</Default></BorderStyle>
                            <BorderColor><Default>#CCCCCC</Default></BorderColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dataRoomType">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!RoomType.Value</Value>
                                  <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize></Style>
                                </TextRun>
                              </TextRuns>
                              <Style><TextAlign>Center</TextAlign></Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <VerticalAlign>Middle</VerticalAlign>
                            <BorderStyle><Default>Solid</Default></BorderStyle>
                            <BorderColor><Default>#CCCCCC</Default></BorderColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
